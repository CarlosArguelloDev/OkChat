# OkChat — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── App ───────────────────────────────────────────────────────────────────────
OKCHAT_APP_NAME="OkChat API"
OKCHAT_APP_VERSION="0.1.0"
OKCHAT_ENVIRONMENT=local
OKCHAT_DEBUG=true
OKCHAT_LOG_LEVEL=DEBUG
OKCHAT_ALLOWED_HOSTS=["*"]
OKCHAT_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Database ──────────────────────────────────────────────────────────────────
OKCHAT_DB__URL=postgresql+asyncpg://okchat:okchat@localhost:5432/okchat
OKCHAT_DB__POOL_SIZE=10
OKCHAT_DB__MAX_OVERFLOW=20
OKCHAT_DB__ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
OKCHAT_REDIS__URL=redis://localhost:6379/0
OKCHAT_REDIS__POOL_SIZE=20

# ── Auth ──────────────────────────────────────────────────────────────────────
# In production, use RS256 with a real private key stored in Vault
OKCHAT_AUTH__SECRET_KEY=change-me-use-a-long-random-string-in-production
OKCHAT_AUTH__ALGORITHM=HS256
OKCHAT_AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=15
OKCHAT_AUTH__REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI ────────────────────────────────────────────────────────────────────
OKCHAT_OPENAI__API_KEY=sk-your-openai-key-here
OKCHAT_OPENAI__DEFAULT_MODEL=gpt-4o
OKCHAT_OPENAI__TIMEOUT=60.0
